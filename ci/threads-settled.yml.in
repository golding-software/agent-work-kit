# Threads settled: a required check that passes when every open, non-outdated review thread on the PR is resolved, or ends in the shared PR review's settled reply (<!-- pr-review:fixed sha=… -->) for the head commit or for an earlier
# commit when the review has recorded the head as reviewed since. Use it in place of the branch rule "require
# conversation resolution", which counts those replies as open. On a pull_request event it first waits for the PR
# review run on the same commit, because the review's own replies do not start workflows.
#
# GENERATED by scripts/build.py from ci/threads-settled.yml.in and ci/threads_settled.py. Edit those, then rebuild.
#
# Call it from a small caller (plugins/pr-review/skills/setup-pr-review/templates/threads-settled.yml); the required
# check is then "threads-settled / check".
name: Threads settled

on:
  workflow_call:
    inputs:
      review-workflow:
        description: The name of the PR review workflow to wait for on the same commit ("" = do not wait)
        type: string
        default: PR review
      wait-minutes:
        description: How long to wait for that review run before failing (it never passes while the review runs)
        type: number
        default: 20

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      pull-requests: read
      actions: read
    steps:
      - name: Every open review thread is resolved or settled
        env:
          GH_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
          REVIEW_WORKFLOW: ${{ inputs.review-workflow }}
          WAIT_MINUTES: ${{ inputs.wait-minutes }}
        run: |
          cat > "$RUNNER_TEMP/threads_settled.py" <<'TS_EOF'
@@THREADS_SETTLED@@
          TS_EOF
          python3 "$RUNNER_TEMP/threads_settled.py" --repo "$GITHUB_REPOSITORY" --pr "$PR_NUMBER" --head "$HEAD_SHA" \
            --wait-for "$REVIEW_WORKFLOW" --wait-minutes "$WAIT_MINUTES" --own-run-id "$GITHUB_RUN_ID"
